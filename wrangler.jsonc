{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hgu-filling-to-flowing",
  "compatibility_date": "2026-09-24",

  // 정적 사이트(next build → out/)를 그대로 서빙한다.
  // "main" 이 없으므로 서버 코드 없이 파일만 올라간다.
  // 이 파일이 있어야 Cloudflare 가 @opennextjs/cloudflare 자동 변환을 건너뛴다.
  "assets": {
    "directory": "./out",
    // /works/abc → /works/abc/index.html (next.config 의 trailingSlash 와 맞춤)
    "html_handling": "auto-trailing-slash",
    // 없는 경로는 out/404.html
    "not_found_handling": "404-page"
  },

  "observability": { "enabled": true }
}
