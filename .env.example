# 사이트 주소 (OG 이미지 절대경로용)
NEXT_PUBLIC_SITE_URL=https://ccd.handong.edu

# 이미지·영상을 외부 주소에서 불러올 때만 쓴다. 평소엔 비워둔다.
# 비어 있으면 /media/... 를 사이트와 같은 주소(public/)에서 불러온다.
# 배포 사이트도 비워둔다 — 미디어는 빌드 때 R2 에서 복사되어 Pages 가 같이 서빙한다.
NEXT_PUBLIC_ASSET_URL=

# 빌드 때 R2 에서 미디어 받기 (npm run pull:media / build:pages)
# 로컬에서는 비워둬도 된다 (public/media 를 그대로 사용). Pages 에는 반드시 등록.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=hgu-degree-2026

# Hotjar(Contentsquare) — 설치 화면의 Tag ID(예: 846119ff47977). 비워 두면 추적 코드를 넣지 않는다
NEXT_PUBLIC_HOTJAR_ID=
